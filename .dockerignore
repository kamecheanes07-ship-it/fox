# Never let a foreign top-level `app/` folder (Python/FastAPI project) reach the
# Next.js build: it would shadow src/app/ and make every route return 404.
/app
# Python side of the Space (entrypoint/app.py/requirements) is not part of the image.
/pyapp
*.py
requirements*.txt
pyproject.toml
entrypoint.sh

node_modules
.next
out
dist
build
coverage
.git
.gitignore
.dockerignore
Dockerfile
docker-compose.yml
npm-debug.log*
yarn-error.log*
.env
.env.*
!.env.example
*.md
!README.md
tsconfig.tsbuildinfo
.DS_Store
.vscode
.idea
